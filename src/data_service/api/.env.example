# Host-run API talking to the ClickHouse service exposed by transform_layer/docker-compose.yaml
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DB=analytics
CLICKHOUSE_SECURE=false

# If the API later runs in Docker on the shared data_pipeline network,
# switch CLICKHOUSE_HOST to the ClickHouse container name used by transform_layer:
# CLICKHOUSE_HOST=transform_clickhouse
